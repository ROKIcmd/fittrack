import { useRef, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import Button from '../../components/Button/Button';
import Checkbox from '../../components/Checkbox/Checkbox';
import { LockIcon, MailIcon } from '../../components/Icons/Icons';
import Logo from '../../components/Logo/Logo';
import PasswordStrength from '../../components/PasswordStrength/PasswordStrength';
import TextField from '../../components/TextField/TextField';
import { checkEmail } from '../../services/authService';
import './MemberSignup.css';

const FIELD_ORDER = ['email', 'password', 'confirmPassword', 'confirmed'];

const INITIAL_VALUES = {
  email: '',
  password: '',
  confirmPassword: '',
  confirmed: false,
};

const INITIAL_SHAKE = { email: 0, password: 0, confirmPassword: 0, confirmed: 0 };

function getErrors(values) {
  const email = values.email.trim();
  const password = values.password;

  let emailError = '';
  if (!email) emailError = 'Email is required.';
  else if (!/^\S+@\S+\.\S+$/.test(email)) emailError = 'Please enter a valid email address.';

  let passwordError = '';
  if (!password) passwordError = 'Password is required.';
  else if (password.length < 6) passwordError = 'Password must be at least 6 characters.';

  let confirmError = '';
  if (!values.confirmPassword) confirmError = 'Please verify your password.';
  else if (values.confirmPassword !== password) confirmError = 'Passwords do not match.';

  return {
    email: emailError,
    password: passwordError,
    confirmPassword: confirmError,
    confirmed: values.confirmed ? '' : 'Please tick “Confirm Password” to continue.',
  };
}

export default function MemberSignup({ loginHref = '/login' }) {
  const navigate = useNavigate();
  const [values, setValues] = useState(INITIAL_VALUES);
  const [touched, setTouched] = useState({});
  const [shake, setShake] = useState(INITIAL_SHAKE);
  const [status, setStatus] = useState('idle');
  const [statusMessage, setStatusMessage] = useState('');

  const inputRefs = {
    email: useRef(null),
    password: useRef(null),
    confirmPassword: useRef(null),
    confirmed: useRef(null),
  };

  const errors = getErrors(values);
  const visibleError = (name) => (touched[name] ? errors[name] : '');
  const isValid = (name) => Boolean(values[name]) && !errors[name];

  function handleChange(event) {
    const { name, type, value, checked } = event.target;
    setValues((prev) => ({ ...prev, [name]: type === 'checkbox' ? checked : value }));
    if (name === 'confirmed') setTouched((prev) => ({ ...prev, confirmed: true }));
    if (status === 'error') setStatus('idle');
  }

  function handleBlur(event) {
    const { name } = event.target;
    setTouched((prev) => ({ ...prev, [name]: true }));
  }

  async function handleSubmit(event) {
    event.preventDefault();
    if (status === 'loading') return;

    setTouched({ email: true, password: true, confirmPassword: true, confirmed: true });

    const invalidFields = FIELD_ORDER.filter((name) => errors[name]);
    if (invalidFields.length > 0) {
      setShake((prev) => {
        const next = { ...prev };
        invalidFields.forEach((name) => { next[name] += 1; });
        return next;
      });
      inputRefs[invalidFields[0]].current?.focus();
      return;
    }

    setStatus('loading');
    try {
      const cleanEmail = values.email.trim();
      // Validate email availability with backend
      await checkEmail(cleanEmail);

      setStatus('idle');
      // Pass verified credentials to step 2
      navigate('/register/details', {
        state: { email: cleanEmail, password: values.password },
      });
    } catch (error) {
      setStatusMessage(error.message || 'Email is already taken or invalid.');
      setStatus('error');
      setShake((prev) => ({ ...prev, email: prev.email + 1 }));
    }
  }

  const reveal = (index) => ({ '--i': index });
  const statusOpen = status === 'error';

  return (
    <main className="signup">
      <div className="signup__photo" aria-hidden="true">
        <img className="signup__photo-img" src="/assets/gym-bg.png" alt="" />
      </div>
      <div className="signup__shade" aria-hidden="true" />

      <div className="signup__layout">
        <section className="signup__card" aria-labelledby="signup-title">
          <span className="signup__glow" aria-hidden="true" />

          <h1 id="signup-title" className="signup__title signup-reveal" style={reveal(0)}>
            WELCOME
          </h1>

          <form
            className="signup__form"
            onSubmit={handleSubmit}
            noValidate
            aria-busy={status === 'loading'}
          >
            <TextField
              ref={inputRefs.email}
              className="signup-reveal"
              style={reveal(1)}
              label="Email address"
              name="email"
              type="email"
              inputMode="email"
              autoComplete="email"
              placeholder="juandelacruz@gmail.com"
              icon={MailIcon}
              value={values.email}
              onChange={handleChange}
              onBlur={handleBlur}
              error={visibleError('email')}
              valid={isValid('email')}
              shakeSignal={shake.email}
              required
            />

            <TextField
              ref={inputRefs.password}
              className="signup-reveal"
              style={reveal(2)}
              label="Password"
              name="password"
              type="password"
              autoComplete="new-password"
              placeholder="Enter Password"
              icon={LockIcon}
              value={values.password}
              onChange={handleChange}
              onBlur={handleBlur}
              error={visibleError('password')}
              valid={isValid('password')}
              shakeSignal={shake.password}
              required
            >
              <PasswordStrength password={values.password} />
            </TextField>

            <TextField
              ref={inputRefs.confirmPassword}
              className="signup-reveal"
              style={reveal(3)}
              label="Verify password"
              name="confirmPassword"
              type="password"
              autoComplete="new-password"
              placeholder="Verify Entered Password"
              icon={LockIcon}
              value={values.confirmPassword}
              onChange={handleChange}
              onBlur={handleBlur}
              error={visibleError('confirmPassword')}
              valid={isValid('confirmPassword')}
              shakeSignal={shake.confirmPassword}
              required
            />

            <Checkbox
              ref={inputRefs.confirmed}
              className="signup__confirm signup-reveal"
              style={reveal(4)}
              name="confirmed"
              label="Confirm Password"
              checked={values.confirmed}
              onChange={handleChange}
              onBlur={handleBlur}
              error={visibleError('confirmed')}
              shakeSignal={shake.confirmed}
              required
            />

            <div className="signup__actions signup-reveal" style={reveal(5)}>
              <Button type="submit" loading={status === 'loading'}>
                Continue
              </Button>
            </div>

            <div
              className={`signup__status signup__status--${status}${statusOpen ? ' is-open' : ''}`}
              role="status"
              aria-live="polite"
            >
              <div className="signup__status-inner">
                <p>{statusMessage}</p>
              </div>
            </div>
          </form>

          <hr className="signup__divider signup-reveal" style={reveal(6)} />

          <p className="signup__footer signup-reveal" style={reveal(7)}>
            Already have an account? <a href={loginHref}>Log In</a>
          </p>
        </section>

        <aside className="signup__brand">
          <Logo className="signup-reveal signup__logo" style={reveal(2)} />
          <p className="signup__headline signup-reveal" style={reveal(4)}>
            Track, Manage, Guide and Organize, all in one <span>App</span>
          </p>
        </aside>
      </div>
    </main>
  );
}
</file>

<file path="src/pages/Registration/Registration.css">
/* ==========================================================================
   Registration page
   Design reference: Figma frame "Registratio" (13:91), 1279 × 761.
   Columns, offsets and type sizes below come from that frame; the page is
   anchored to the centre line so it scales with the window.
   ========================================================================== */

.reg {
  --reg-left: max(16px, calc(50% - 479.5px)); /* Figma: left column starts at x = 160 */

  /* Estimate of Figma "Rectangle 4": a dark navy veil over the gym photo.
     Replace with the exported overlay if you need pixel parity. */
  --reg-overlay: linear-gradient(180deg, rgba(15, 23, 42, 0.7) 0%, rgba(15, 23, 42, 0.9) 100%);

  position: relative;
  display: grid;
  align-content: center;
  min-height: 100vh;
  min-height: 100dvh;
  padding: 47px 0 19px; /* Figma: title text starts at y = 47 */
  background: var(--color-bg);
  overflow: hidden;
  isolation: isolate;

  /* Shared TextField styling for this page (Figma: white 24px labels,
     text starts 45px inside wide pills) */
  --tf-label-size: 24px;
  --tf-label-color: #fff;
  --tf-padding-left: 45px;
}

/* ---- Photo + overlay --------------------------------------------------- */

.reg__photo {
  position: absolute;
  inset: 0;
  z-index: -2;
  overflow: hidden;
  animation: reg-fade 1200ms var(--ease-out) backwards;
}

/* Figma crop: image is 111.72% of the frame width and shifted up so the
   dumbbell racks fill the view. Translating by a % of its own height keeps
   that crop at any window width. */
.reg__photo-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 111.72%;
  max-width: none;
  height: auto;
  transform: translateY(-38.4%);
}

.reg__shade {
  position: absolute;
  inset: 0;
  z-index: -1;
  background: var(--reg-overlay);
}

/* ---- Title ------------------------------------------------------------- */

.reg__title {
  margin: 0;
  color: #fff;
  font-family: var(--font-display);
  font-size: clamp(36px, 4.07vw, 52px);
  font-weight: 400;
  line-height: 1.12; /* ≈58px at 52px: headings sit right under it, as in Figma */
  text-align: center;
}

/* ---- Content layout ---------------------------------------------------- */

.reg__content {
  /* Spans x = 160 → 1240 in the design (right column + the button overhang) */
  width: min(1080px, calc(100% - var(--reg-left) - 16px));
  margin-left: var(--reg-left);
}

.reg__body {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  width: min(1000px, 100%);
}

.reg__col {
  min-width: 0;
}

/* Per-column rhythm taken from the Figma label/field spacing */
.reg__col--left {
  --tf-label-gap: 6px;
  --tf-label-indent: 14px;
  --reg-row-gap: 8px;
  --reg-heading-shift: -10px; /* heading x = 150, fields x = 160 */
}

.reg__col--right {
  --tf-label-gap: 3px;
  --tf-label-indent: 7px;
  --reg-row-gap: 0px;
  --reg-heading-shift: 0px;
}

.reg__heading {
  margin: 0 0 20px var(--reg-heading-shift);
  color: #fff;
  font-family: var(--font-display);
  font-size: clamp(28px, 3.13vw, 40px);
  font-weight: 400;
  line-height: 1.1;
}

.reg__subheading {
  /* Figma: x = 148, 30px type. Margins are net of the 8px flex gap above and below. */
  margin: 11px 0 -6px -12px;
  color: #fff;
  font-family: var(--font-display);
  font-size: clamp(22px, 2.35vw, 30px);
  font-weight: 400;
  line-height: 1.2;
}

.reg__fields {
  display: flex;
  flex-direction: column;
  gap: var(--reg-row-gap);
}

/* Two narrow pills side by side (Figma: 189 + 58 gap + 189) */
.reg__row {
  --tf-padding-left: 24px;
  --tf-padding-right: 12px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 58px;
  align-items: start;
}

/* Narrow dropdown: keep "Male/Female" fully visible next to the chevron */
.reg__row .tf__select {
  padding-right: 20px;
}

/* ---- Divider ------------------------------------------------------------ */

.reg__divider {
  align-self: stretch;
  width: 3px;
  margin: 52px 81px 6px 44px; /* Figma: x = 640, y = 157 → 642 */
  border-radius: 2px;
  background: #fff;
}

/* ---- QR block ----------------------------------------------------------- */

.reg__qr-label {
  margin: 0 0 var(--tf-label-gap) var(--tf-label-indent);
  color: #fff;
  font: 24px/1.2 var(--font-body);
}

.reg__qr .qr {
  margin-left: 161px; /* Figma: QR x = 885, column x = 724 */
  margin-bottom: 0;
}

/* ---- Footer: status + button -------------------------------------------- */

.reg__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20px;
  margin-top: 36px; /* Figma: button y = 684 */
}

.reg__status {
  flex: 1;
  margin: 0;
  color: var(--color-text-on-dark);
  font: 17px/1.35 var(--font-body);
  text-align: right;
  opacity: 0;
  transform: translateY(4px);
  transition:
    opacity var(--dur-base) var(--ease-out),
    transform var(--dur-base) var(--ease-out);
}

.reg__status.is-open {
  opacity: 1;
  transform: none;
}

.reg__status--success {
  color: var(--color-success-text);
}

.reg__status--error {
  color: var(--color-error-text);
}

/* ---- Entrance animation (staggered via --i) ----------------------------- */

.reg-reveal {
  animation: reg-rise 650ms var(--ease-out) backwards;
  animation-delay: calc(100ms + var(--i, 0) * 50ms);
}

/* ---- Laptop: a little tighter ------------------------------------------- */

@media (max-width: 1100px) {
  .reg__row {
    column-gap: 24px;
  }

  .reg__divider {
    margin-inline: 24px 40px;
  }

  .reg__qr .qr {
    margin-left: clamp(0px, 8vw, 80px);
  }
}

/* ---- Tablet / mobile: one column ---------------------------------------- */

@media (max-width: 860px) {
  .reg {
    --reg-overlay: linear-gradient(180deg, rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.92));
    --tf-padding-left: 28px;
    padding-top: 32px;
  }

  .reg__photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: none;
  }

  .reg__content {
    width: min(560px, calc(100% - 32px));
    margin-inline: auto;
  }

  .reg__body {
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
    row-gap: 24px;
  }

  .reg__col--left,
  .reg__col--right {
    --tf-label-gap: 6px;
    --tf-label-indent: 14px;
    --reg-row-gap: 10px;
    --reg-heading-shift: 0px;
  }

  .reg__heading {
    margin-bottom: 12px;
  }

  .reg__subheading {
    margin-left: 0;
  }

  .reg__row {
    column-gap: 16px;
  }

  .reg__divider {
    width: 100%;
    height: 3px;
    margin: 0;
  }

  .reg__qr .qr {
    margin-left: 14px;
  }

  .reg__actions {
    flex-direction: column-reverse;
    align-items: stretch;
    gap: 12px;
  }

  .reg__actions .btn {
    width: 100%;
  }

  .reg__status {
    text-align: center;
  }
}

@media (max-width: 480px) {
  .reg {
    --tf-label-size: 20px;
    --tf-height: 56px;
    --tf-radius: 28px;
    --tf-font-size: 18px;
  }

  .reg__row {
    --tf-padding-left: 18px;
    --tf-padding-right: 10px;
  }
}

/* ---- Keyframes ----------------------------------------------------------- */

@keyframes reg-rise {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes reg-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
</file>

