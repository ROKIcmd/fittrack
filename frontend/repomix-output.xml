/* ==========================================================================
   Checkbox – reusable
   Figma: 14 × 12 box (#d9d9d9) with a 20px Goudy Old Style label.
   The label has a 32px min-height so it is easy to tap.
   Override --cb-indent / --cb-font-size where it is used.
   ========================================================================== */

.cb {
  width: 100%;
}

.cb__label {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 32px;
  margin-left: var(--cb-indent, 28px);
  color: var(--color-text-on-dark);
  font: var(--cb-font-size, 20px) / 1.2 var(--font-body);
  cursor: pointer;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}

.cb__label.is-disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.cb__label.is-shaking {
  animation: cb-shake 450ms cubic-bezier(0.36, 0.07, 0.19, 0.97);
}

/* Real checkbox stays in the DOM (focus, keyboard, screen readers) */
.cb__input {
  position: absolute;
  left: 0;
  width: 14px;
  height: 14px;
  margin: 0;
  opacity: 0;
}

.cb__box {
  position: relative;
  flex: none;
  width: 14px;
  height: 12px;
  border-radius: 2px;
  background: var(--color-checkbox);
  box-shadow: 0 0 0 0 transparent;
  transition:
    background-color var(--dur-base) var(--ease-out),
    box-shadow var(--dur-base) var(--ease-out),
    transform var(--dur-fast) var(--ease-out);
}

@media (hover: hover) {
  .cb__label:hover .cb__box {
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.12);
  }
}

.cb__label:active .cb__box {
  transform: scale(0.88);
}

.cb__input:checked + .cb__box {
  background: var(--color-primary);
}

.cb__input:focus-visible + .cb__box {
  outline: 2px solid #fff;
  outline-offset: 3px;
}

.cb.is-invalid .cb__box {
  box-shadow: 0 0 0 2px var(--color-error);
}

/* Check mark draws itself */
.cb__check {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  fill: none;
  stroke: #fff;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-dasharray: 1;
  stroke-dashoffset: 1;
  transition: stroke-dashoffset var(--dur-base) var(--ease-out);
}

.cb__input:checked + .cb__box .cb__check {
  stroke-dashoffset: 0;
}

/* ---- Error message ------------------------------------------------------ */

.cb__message {
  display: grid;
  grid-template-rows: 0fr;
  opacity: 0;
  transition: grid-template-rows var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out);
}

.cb__message.is-open {
  grid-template-rows: 1fr;
  opacity: 1;
}

.cb__message-inner {
  min-height: 0;
  overflow: hidden;
}

.cb__error {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  margin: 0;
  padding: 2px 18px 0 var(--cb-indent, 28px);
  color: var(--color-error-text);
  font: 16px/1.3 var(--font-body);
}

.cb__error svg {
  flex: none;
  margin-top: 1px;
}

@keyframes cb-shake {
  10%,
  90% {
    transform: translateX(-1px);
  }
  20%,
  80% {
    transform: translateX(2px);
  }
  30%,
  50%,
  70% {
    transform: translateX(-4px);
  }
  40%,
  60% {
    transform: translateX(4px);
  }
}
