import { forwardRef, useEffect, useId, useState } from 'react';
import { AlertIcon, ChevronDownIcon } from '../Icons/Icons';
import '../TextField/TextField.css';
import './Select.css';

/**
 * Dropdown that looks and behaves like <TextField> (same pill, focus ring,
 * valid/invalid states, shake and animated error message). It wraps a native
 * <select>, so it is keyboard- and screen-reader-friendly and uses the
 * platform picker on phones.
 *
 * Props
 *  label, labelVisible, id, name, value, onChange, onBlur
 *  options        [{ value, label }, …] or plain strings
 *  placeholder    Greyed first option shown while nothing is chosen
 *  error, hint, valid, required, disabled, shakeSignal, className, style
 *
 * Style with the same CSS variables as TextField (--tf-height, --tf-radius,
 * --tf-padding-left, --tf-label-*, …). The ref points at the <select>.
 */
const Select = forwardRef(function Select(
  {
    label,
    labelVisible = false,
    id,
    name,
    value,
    onChange,
    onBlur,
    options = [],
    placeholder = 'Select…',
    error = '',
    hint = '',
    valid = false,
    required = false,
    disabled = false,
    shakeSignal = 0,
    className = '',
    style,
  },
  ref,
) {
  const generatedId = useId();
  const selectId = id || generatedId;
  const messageId = `${selectId}-message`;

  const [shaking, setShaking] = useState(false);
  const [last, setLast] = useState({ text: '', isError: false });

  useEffect(() => {
    if (shakeSignal > 0) setShaking(true);
  }, [shakeSignal]);

  const active = error || hint;
  useEffect(() => {
    if (active) setLast({ text: active, isError: Boolean(error) });
  }, [active, error]);
  const shown = active ? { text: active, isError: Boolean(error) } : last;

  const fieldClass = [
    'tf__field',
    error && 'is-invalid',
    !error && valid && 'is-valid',
    disabled && 'is-disabled',
    shaking && 'is-shaking',
  ]
    .filter(Boolean)
    .join(' ');

  function handleAnimationEnd(event) {
    if (event.target === event.currentTarget) setShaking(false);
  }

  const normalised = options.map((option) =>
    typeof option === 'string' ? { value: option, label: option } : option,
  );

  return (
    <div className={`tf ${className}`.trim()} style={style}>
      <label htmlFor={selectId} className={labelVisible ? 'tf__label' : 'sr-only'}>
        {label}
      </label>

      <div className={fieldClass} onAnimationEnd={handleAnimationEnd}>
        <select
          ref={ref}
          id={selectId}
          name={name}
          className={`tf__input tf__select${value === '' ? ' is-placeholder' : ''}`}
          value={value}
          onChange={onChange}
          onBlur={onBlur}
          required={required}
          disabled={disabled}
          aria-invalid={error ? 'true' : undefined}
          aria-describedby={active ? messageId : undefined}
        >
          <option value="" disabled>
            {placeholder}
          </option>
          {normalised.map((option) => (
            <option key={option.value} value={option.value}>
              {option.label}
            </option>
          ))}
        </select>

        <span className="tf__chevron" aria-hidden="true">
          <ChevronDownIcon size={18} />
        </span>
      </div>

      <div className={`tf__message${active ? ' is-open' : ''}`} aria-live="polite">
        <div className="tf__message-inner" aria-hidden={!active}>
          <p id={messageId} className={`tf__text${shown.isError ? ' is-error' : ''}`}>
            {shown.isError && <AlertIcon className="tf__text-icon" size={16} />}
            <span>{shown.text}</span>
          </p>
        </div>
      </div>
    </div>
  );
});

export default Select;
</file>

<file path="src/components/TextField/TextField.css">
/* ==========================================================================
   TextField – reusable animated input
   Customise with CSS variables on the element or any ancestor:
   --tf-height, --tf-radius, --tf-bg, --tf-font-size, --tf-gap,
   --tf-padding-left, --tf-padding-right,
   --tf-label-size, --tf-label-color, --tf-label-gap, --tf-label-indent
   Figma defaults: 64px tall, 30px radius, #f1f5f9, 24px Goudy Old Style.
   ========================================================================== */

.tf {
  width: 100%;
}

.tf__label {
  display: block;
  margin: 0 0 var(--tf-label-gap, 8px) var(--tf-label-indent, 18px);
  font-family: var(--font-body);
  font-size: var(--tf-label-size, 18px);
  line-height: 1.2;
  color: var(--tf-label-color, var(--color-text-on-dark));
}

/* ---- Field shell ------------------------------------------------------- */

.tf__field {
  --tf-ring: transparent;
  --tf-glow: transparent;
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--tf-gap, 14px);
  height: var(--tf-height, 64px);
  padding-inline: var(--tf-padding-left, 18px) var(--tf-padding-right, 18px);
  background: var(--tf-bg, var(--color-field));
  border-radius: var(--tf-radius, var(--radius-field));
  box-shadow: 0 0 0 3px var(--tf-ring), 0 0 22px var(--tf-glow);
  transition: box-shadow var(--dur-base) var(--ease-out);
}

.tf__field:focus-within {
  --tf-ring: rgba(59, 130, 246, 0.7);
  --tf-glow: rgba(59, 130, 246, 0.35);
}

.tf__field.is-valid {
  --tf-ring: rgba(34, 197, 94, 0.55);
}

.tf__field.is-valid:focus-within {
  --tf-ring: rgba(34, 197, 94, 0.8);
  --tf-glow: rgba(34, 197, 94, 0.3);
}

.tf__field.is-invalid {
  --tf-ring: rgba(239, 68, 68, 0.8);
  --tf-glow: rgba(239, 68, 68, 0.3);
}

.tf__field.is-disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.tf__field.is-shaking {
  animation: tf-shake 450ms cubic-bezier(0.36, 0.07, 0.19, 0.97);
}

/* ---- Leading icon + divider ------------------------------------------- */

.tf__icon {
  display: grid;
  place-items: center;
  flex: none;
  width: 27px;
  margin-right: 3px;
  color: var(--color-icon);
  transition: color var(--dur-base) var(--ease-out);
}

.tf__divider {
  flex: none;
  width: 2px;
  height: 38px;
  border-radius: 1px;
  background: var(--color-field-divider);
  transition: background-color var(--dur-base) var(--ease-out);
}

.tf__field:focus-within .tf__icon {
  color: var(--color-primary);
}

.tf__field:focus-within .tf__divider {
  background: var(--color-primary);
}

.tf__field.is-invalid .tf__icon {
  color: var(--color-error);
}

.tf__field.is-invalid .tf__divider {
  background: var(--color-error);
}

/* ---- Input ------------------------------------------------------------- */

.tf__input {
  flex: 1;
  min-width: 0;
  height: 100%;
  padding: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--color-field-text);
  font-family: var(--font-body);
  font-size: var(--tf-font-size, 24px);
  line-height: 1;
  text-overflow: ellipsis;
}

/* The whole pill shows the focus ring (via :focus-within), so the bare input
   must not draw its own rectangle. Higher specificity than the global rule. */
.tf__input:focus-visible {
  outline: none;
}

.tf__input::placeholder {
  color: var(--color-placeholder);
  opacity: 1;
  transition: opacity var(--dur-base) var(--ease-out);
}

.tf__input:focus::placeholder {
  opacity: 0.55;
}

.tf__input:disabled {
  cursor: not-allowed;
}

/* Number inputs: no spinner arrows inside the pill */
.tf__input[type='number'] {
  -moz-appearance: textfield;
  appearance: textfield;
}

.tf__input[type='number']::-webkit-inner-spin-button,
.tf__input[type='number']::-webkit-outer-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

/* Date inputs: grey "mm/dd/yyyy" hint while empty, softer calendar icon */
.tf__input[type='date'][data-empty='true']:not(:focus) {
  color: var(--color-placeholder);
}

.tf__input[type='date']::-webkit-calendar-picker-indicator {
  opacity: 0.55;
  cursor: pointer;
}

/* Keep browser autofill from painting its own yellow/blue background */
.tf__input:-webkit-autofill {
  -webkit-box-shadow: 0 0 0 100px var(--color-field) inset;
  -webkit-text-fill-color: var(--color-field-text);
}

/* ---- Password toggle --------------------------------------------------- */

.tf__toggle {
  display: grid;
  place-items: center;
  flex: none;
  width: 40px;
  height: 40px;
  margin-right: -10px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: var(--color-icon);
  cursor: pointer;
  transition: color var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);
  -webkit-tap-highlight-color: transparent;
}

.tf__toggle:hover:not(:disabled) {
  color: var(--color-primary);
  background: rgba(59, 130, 246, 0.1);
}

.tf__toggle:disabled {
  cursor: not-allowed;
}

.tf__eye {
  position: relative;
  display: block;
  width: 24px;
  height: 24px;
}

.tf__eye svg {
  position: absolute;
  inset: 0;
  transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
}

.tf__eye-off {
  opacity: 0;
  transform: scale(0.6) rotate(-20deg);
}

.tf__eye.is-visible .tf__eye-on {
  opacity: 0;
  transform: scale(0.6) rotate(20deg);
}

.tf__eye.is-visible .tf__eye-off {
  opacity: 1;
  transform: none;
}

/* ---- Valid check mark -------------------------------------------------- */

.tf__status {
  flex: none;
  display: grid;
  place-items: center;
  color: var(--color-success);
  animation: tf-pop 300ms var(--ease-out);
}

/* ---- Error / hint message (animated collapse, no layout jump) ---------- */

.tf__message {
  display: grid;
  grid-template-rows: 0fr;
  opacity: 0;
  transition: grid-template-rows var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out);
}

.tf__message.is-open {
  grid-template-rows: 1fr;
  opacity: 1;
}

.tf__message-inner {
  min-height: 0;
  overflow: hidden;
}

.tf__text {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  margin: 0;
  padding: 8px 18px 0;
  font: 16px/1.3 var(--font-body);
  color: var(--color-text-on-dark);
  opacity: 0.8;
}

.tf__text.is-error {
  color: var(--color-error-text);
  opacity: 1;
}

.tf__text-icon {
  flex: none;
  margin-top: 1px;
}

/* ---- Keyframes --------------------------------------------------------- */

@keyframes tf-shake {
  10%,
  90% {
    transform: translateX(-1px);
  }
  20%,
  80% {
    transform: translateX(2px);
  }
  30%,
  50%,
  70% {
    transform: translateX(-4px);
  }
  40%,
  60% {
    transform: translateX(4px);
  }
}

@keyframes tf-pop {
  from {
    opacity: 0;
    transform: scale(0.5);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
</file>

<file path="src/components/TextField/TextField.jsx">
import { forwardRef, useEffect, useId, useState } from 'react';
import { AlertIcon, CheckIcon, EyeIcon, EyeOffIcon } from '../Icons/Icons';
import './TextField.css';

/**
 * Reusable animated text input (Login, Sign Up, Forgot Password, …).
 *
 * Props
 *  label          Accessible label (visually hidden unless labelVisible)
 *  labelVisible   Show the label above the field
 *  id, name, type, value, onChange, onBlur, onFocus, placeholder
 *  icon           Optional leading icon component, e.g. MailIcon
 *  error          Error message – turns the field red and slides the message in
 *  hint           Helper text shown when there is no error
 *  valid          Shows the "valid" state (green ring, check mark)
 *  required, disabled, autoComplete, inputMode
 *  shakeSignal    Increase this number to play the shake animation
 *  className, style   Customise via props or CSS variables
 *                 (--tf-height, --tf-radius, --tf-bg, --tf-font-size, --tf-gap)
 *  inputProps     Extra attributes forwarded to the <input>
 *  children       Extra content below the field (e.g. <PasswordStrength />)
 *
 * type="password" automatically gets a show/hide toggle.
 * The ref points at the underlying <input>.
 */
const TextField = forwardRef(function TextField(
  {
    label,
    labelVisible = false,
    id,
    name,
    type = 'text',
    value,
    onChange,
    onBlur,
    onFocus,
    placeholder,
    icon: LeadingIcon,
    error = '',
    hint = '',
    valid = false,
    required = false,
    disabled = false,
    autoComplete,
    inputMode,
    shakeSignal = 0,
    className = '',
    style,
    inputProps,
    children,
  },
  ref,
) {
  const generatedId = useId();
  const inputId = id || generatedId;
  const messageId = `${inputId}-message`;
  const isPassword = type === 'password';

  const [passwordVisible, setPasswordVisible] = useState(false);
  const [shaking, setShaking] = useState(false);
  const [last, setLast] = useState({ text: '', isError: false });

  // Start the shake animation whenever the parent bumps shakeSignal.
  useEffect(() => {
    if (shakeSignal > 0) setShaking(true);
  }, [shakeSignal]);

  // Remember the last message so its text stays visible while it collapses.
  const active = error || hint;
  useEffect(() => {
    if (active) setLast({ text: active, isError: Boolean(error) });
  }, [active, error]);
  const shown = active ? { text: active, isError: Boolean(error) } : last;

  const fieldClass = [
    'tf__field',
    error && 'is-invalid',
    !error && valid && 'is-valid',
    disabled && 'is-disabled',
    shaking && 'is-shaking',
  ]
    .filter(Boolean)
    .join(' ');

  function handleAnimationEnd(event) {
    if (event.target === event.currentTarget) setShaking(false);
  }

  return (
    <div className={`tf ${className}`.trim()} style={style}>
      <label htmlFor={inputId} className={labelVisible ? 'tf__label' : 'sr-only'}>
        {label}
      </label>

      <div className={fieldClass} onAnimationEnd={handleAnimationEnd}>
        {LeadingIcon && (
          <>
            <span className="tf__icon">
              <LeadingIcon size={26} />
            </span>
            <span className="tf__divider" aria-hidden="true" />
          </>
        )}

        <input
          ref={ref}
          id={inputId}
          name={name}
          className="tf__input"
          type={isPassword && passwordVisible ? 'text' : type}
          value={value}
          onChange={onChange}
          onBlur={onBlur}
          onFocus={onFocus}
          placeholder={placeholder}
          required={required}
          disabled={disabled}
          autoComplete={autoComplete}
          inputMode={inputMode}
          data-empty={value ? 'false' : 'true'}
          aria-invalid={error ? 'true' : undefined}
          aria-describedby={active ? messageId : undefined}
          {...inputProps}
        />

        {isPassword ? (
          <button
            type="button"
            className="tf__toggle"
            onClick={() => setPasswordVisible((visible) => !visible)}
            onMouseDown={(event) => event.preventDefault()}
            aria-label={passwordVisible ? 'Hide password' : 'Show password'}
            aria-pressed={passwordVisible}
            disabled={disabled}
          >
            <span className={`tf__eye${passwordVisible ? ' is-visible' : ''}`}>
              <EyeIcon className="tf__eye-on" size={24} />
              <EyeOffIcon className="tf__eye-off" size={24} />
            </span>
          </button>
        ) : (
          valid &&
          !error &&
          type !== 'date' && (
            <span className="tf__status" aria-hidden="true">
              <CheckIcon size={22} strokeWidth={2.5} />
            </span>
          )
        )}
      </div>

      <div className={`tf__message${active ? ' is-open' : ''}`} aria-live="polite">
        <div className="tf__message-inner" aria-hidden={!active}>
          <p id={messageId} className={`tf__text${shown.isError ? ' is-error' : ''}`}>
            {shown.isError && <AlertIcon className="tf__text-icon" size={16} />}
            <span>{shown.text}</span>
          </p>
        </div>
      </div>

      {children}
    </div>
  );
});

export default TextField;
</file>

