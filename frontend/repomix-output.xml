import { Link } from "react-router-dom";

const variants = {
  solid: "bg-blue-500 hover:bg-blue-600",
  outline: "border-2 border-white hover:bg-white/10",
};

const sizes = {
  sm: "rounded-full px-5 py-2 text-base md:px-9 md:text-xl",
  lg: "rounded-[30px] px-10 py-4 text-xl md:px-12 md:text-2xl",
};

// Pass `to` to render a router <Link>; otherwise renders a <button>.
export default function Button({ to, variant = "solid", size = "sm", className = "", children, ...props }) {
  const classes = `inline-block font-ui font-bold text-white transition ${variants[variant]} ${sizes[size]} ${className}`;
  if (to) {
    return (
      <Link to={to} className={classes} {...props}>
        {children}
      </Link>
    );
  }
  return (
    <button className={classes} {...props}>
      {children}
    </button>
  );
}
</file>

<file path="src/components/CountUp.jsx">
import { useEffect, useState } from "react";

// Counts from 0 up to `to` (skipped if the user prefers reduced motion).
export default function CountUp({ to, decimals = 1, duration = 1200, delay = 0 }) {
  const [v, setV] = useState(0);
  useEffect(() => {
    if (window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) { setV(to); return; }
    let raf, start;
    const t = setTimeout(() => {
      const step = (now) => {
        start ??= now;
        const p = Math.min((now - start) / duration, 1);
        setV(to * (1 - Math.pow(1 - p, 3)));
        if (p < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    }, delay);
    return () => { clearTimeout(t); cancelAnimationFrame(raf); };
  }, [to, duration, delay]);
  return <>{v.toFixed(decimals)}</>;
}
</file>

