<file path="src/components/Button/Button.css">
/* ==========================================================================
   Button – reusable
   Figma defaults (primary): 203 × 58, radius 25, #3b82f6,
   Google Sans Code Bold 24px, white text.
   Override with --btn-width / --btn-height or the width / height props.
   ========================================================================== */

.btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: var(--btn-width, 203px);
  max-width: 100%;
  height: var(--btn-height, 58px);
  padding: 0 24px;
  border: 2px solid transparent;
  border-radius: var(--radius-button);
  background: var(--color-primary);
  color: #fff;
  font-family: var(--font-mono);
  font-size: 24px;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
  cursor: pointer;
  overflow: hidden;
  box-shadow: 0 8px 18px -8px rgba(59, 130, 246, 0.6);
  transition:
    transform var(--dur-base) var(--ease-out),
    box-shadow var(--dur-base) var(--ease-out),
    background-color var(--dur-base) var(--ease-out),
    border-color var(--dur-base) var(--ease-out),
    color var(--dur-base) var(--ease-out),
    opacity var(--dur-base) var(--ease-out);
  -webkit-tap-highlight-color: transparent;
}

.btn--full {
  width: 100%;
}

.btn:focus-visible {
  outline: 3px solid #fff;
  outline-offset: 3px;
}

.btn__content {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: opacity var(--dur-fast) var(--ease-out);
}

.btn__icon {
  flex: none;
}

/* ---- Hover / press (only where hover exists, never while busy) ---------- */

@media (hover: hover) {
  .btn:hover:not(:disabled):not([aria-disabled='true']) {
    transform: translateY(-2px);
    background: var(--color-primary-hover);
    box-shadow: 0 14px 24px -10px rgba(59, 130, 246, 0.75);
  }
}

.btn:active:not(:disabled):not([aria-disabled='true']) {
  transform: translateY(0) scale(0.97);
  box-shadow: 0 4px 10px -6px rgba(59, 130, 246, 0.6);
}

/* ---- Loading ------------------------------------------------------------ */

.btn.is-loading {
  cursor: progress;
}

.btn.is-loading .btn__content {
  opacity: 0;
}

.btn__spinner {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
}

.btn__spinner svg {
  animation: btn-spin 800ms linear infinite;
}

/* ---- Success ------------------------------------------------------------ */

.btn.is-success {
  background: var(--color-success);
  box-shadow: 0 8px 18px -8px rgba(34, 197, 94, 0.6);
}

.btn.is-success .btn__icon {
  animation: btn-pop 350ms var(--ease-out);
}

/* ---- Disabled ----------------------------------------------------------- */

.btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  box-shadow: none;
}

/* ---- Variants ----------------------------------------------------------- */

.btn--secondary {
  background: transparent;
  border-color: var(--color-text-on-dark);
  color: var(--color-text-on-dark);
  box-shadow: none;
}

@media (hover: hover) {
  .btn--secondary:hover:not(:disabled):not([aria-disabled='true']) {
    background: rgba(241, 245, 249, 0.1);
    box-shadow: none;
  }
}

.btn--ghost {
  background: transparent;
  color: var(--color-primary);
  box-shadow: none;
}

@media (hover: hover) {
  .btn--ghost:hover:not(:disabled):not([aria-disabled='true']) {
    background: rgba(59, 130, 246, 0.12);
    box-shadow: none;
  }
}

/* ---- Keyframes ---------------------------------------------------------- */

@keyframes btn-spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes btn-pop {
  from {
    opacity: 0;
    transform: scale(0.4);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
