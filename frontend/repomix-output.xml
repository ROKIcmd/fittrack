<file path="src/components/ProgressChart.jsx">
import { useState } from "react";

const W = 700, H = 300, P = { l: 54, r: 28, t: 24, b: 44 };

// Render with key={month} so the line redraws when the month changes.
export default function ProgressChart({ points, month, xTicks }) {
  const [active, setActive] = useState(points.length - 1);
  const vals = points.map((p) => p.value);
  const min = Math.floor(Math.min(...vals) / 2) * 2;
  const max = Math.ceil(Math.max(...vals) / 2) * 2;
  const yTicks = Array.from({ length: (max - min) / 2 + 1 }, (_, i) => min + i * 2);
  const d0 = points[0].day, d1 = points[points.length - 1].day;
  const x = (d) => P.l + ((d - d0) / (d1 - d0)) * (W - P.l - P.r);
  const y = (v) => H - P.b - ((v - min) / (max - min)) * (H - P.t - P.b);

  const line = points.map((p, i) => `${i ? "L" : "M"}${x(p.day)} ${y(p.value)}`).join(" ");
  const area = `${line} L${x(d1)} ${H - P.b} L${x(d0)} ${H - P.b} Z`;
  const a = points[active];
  const tipX = Math.min(Math.max(x(a.day) - 38, 4), W - 84);

  return (
    <svg viewBox={`0 0 ${W} ${H}`} className="w-full" role="img" aria-label="Muscle mass over the month">
      <defs>
        <linearGradient id="area" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stopColor="#3b82f6" stopOpacity="0.55" />
          <stop offset="1" stopColor="#3b82f6" stopOpacity="0" />
        </linearGradient>
      </defs>

      {yTicks.map((t) => (
        <g key={t}>
          <line x1={P.l} x2={W - P.r} y1={y(t)} y2={y(t)} stroke="#3b4a60" strokeOpacity="0.6" />
          <text x={P.l - 12} y={y(t) + 4} textAnchor="end" fill="#9fb4d4" fontSize="12">{t}</text>
        </g>
      ))}
      {xTicks.map((d) => (
        <g key={d}>
          <line x1={x(d)} x2={x(d)} y1={P.t} y2={H - P.b} stroke="#3b4a60" strokeOpacity="0.4" />
          <text x={x(d)} y={H - P.b + 22} textAnchor="middle" fill="#9fb4d4" fontSize="12">{month} {d}</text>
        </g>
      ))}
      <text transform={`translate(14 ${H / 2}) rotate(-90)`} textAnchor="middle" fill="#9fb4d4" fontSize="11">Muscle Mass (kg)</text>

      <path d={area} fill="url(#area)" className="animate-fade-in" style={{ animationDelay: "1.1s" }} />
      <path
        d={line} pathLength="1" fill="none" stroke="#3b82f6" strokeWidth="3"
        strokeLinejoin="round" strokeLinecap="round" className="animate-draw"
        style={{ filter: "drop-shadow(0 0 6px #3b82f6)" }}
      />

      {points.map((p, i) => (
        <g key={p.day}>
          <circle
            cx={x(p.day)} cy={y(p.value)} r={i === active ? 6 : 3.5} fill="#60a5fa"
            className="animate-pop-in transition-all"
            style={{ animationDelay: `${(i / (points.length - 1)) * 1.4}s`, transformOrigin: "center", transformBox: "fill-box", filter: "drop-shadow(0 0 5px #3b82f6)" }}
          />
          <circle cx={x(p.day)} cy={y(p.value)} r="11" fill="transparent" onMouseEnter={() => setActive(i)} onClick={() => setActive(i)} style={{ cursor: "pointer" }} />
        </g>
      ))}

      <circle key={`ring${active}`} cx={x(a.day)} cy={y(a.value)} r="9" fill="none" stroke="#60a5fa" className="animate-ring" style={{ transformOrigin: "center", transformBox: "fill-box" }} />
      <g key={`tip${active}`} className="animate-pop-in" style={{ animationDelay: "0.2s", transformOrigin: `${tipX + 38}px ${y(a.value) - 14}px` }}>
        <rect x={tipX} y={y(a.value) - 60} width="76" height="42" rx="10" fill="#0f1b33" stroke="#3b82f6" />
        <text x={tipX + 38} y={y(a.value) - 40} textAnchor="middle" fill="#fff" fontSize="15" fontWeight="700">{a.value} kg</text>
        <text x={tipX + 38} y={y(a.value) - 25} textAnchor="middle" fill="#9fb4d4" fontSize="11">{month} {a.day}</text>
      </g>
    </svg>
  );
}
</file>

<file path="src/components/RescheduleForm.jsx">
import { useState } from "react";
import { TIME_SLOTS, fmtDate } from "../data/workoutPlans";

const field = "h-8 w-full rounded-full bg-[#d9d9d9] px-4 text-sm text-black outline-none focus:ring-2 focus:ring-blue-400";

function Field({ label, children }) {
  return (
    <label className="block">
      <span className="mb-1 block text-base">{label}</span>
      {children}
    </label>
  );
}

/**
 * How rescheduling works:
 * 1. The member picks one of their upcoming sessions, a new date, a new time slot and a reason.
 * 2. Submitting creates a request with status "pending" (it shows on the calendar).
 * 3. The trainer approves or declines it on their Rescheduling page. If approved, the session
 *    moves to the new date and the old one is logged as "Rescheduled" in the Workout Log.
 */
export default function RescheduleForm({ sessions, selectedIso, todayIso, holidays, onSubmit }) {
  const empty = { session: "", newDate: "", slot: "", reason: "" };
  const [form, setForm] = useState(empty);
  const [sent, setSent] = useState(false);

  const set = (k) => (e) => {
    setSent(false);
    setForm((f) => ({ ...f, [k]: e.target.value }));
  };

  // Picking a session on the calendar pre-fills "Select Session"
  const preset = sessions.some((s) => s.date === selectedIso) ? selectedIso : "";
  const session = form.session || preset;

  const error =
    form.newDate && form.newDate < todayIso ? "Pick today or a later date."
    : form.newDate && form.newDate === session ? "Choose a different date from the original session."
    : "";
  const holiday = holidays[form.newDate];
  const valid = session && form.newDate && form.slot && form.reason.trim() && !error;

  const submit = (e) => {
    e.preventDefault();
    if (!valid) return;
    onSubmit({ session, newDate: form.newDate, slot: form.slot, reason: form.reason.trim() });
    setForm(empty);
    setSent(true);
  };

  return (
    <form onSubmit={submit} className="space-y-3">
      <div className="grid gap-x-6 gap-y-3 sm:grid-cols-2">
        <Field label="Select Session">
          <select value={session} onChange={set("session")} className={field}>
            <option value="">Choose a session</option>
            {sessions.map((s) => (
              <option key={s.date} value={s.date}>{fmtDate(s.date)} · {s.title} · {s.time}</option>
            ))}
          </select>
        </Field>
        <Field label="New Date">
          <input type="date" min={todayIso} value={form.newDate} onChange={set("newDate")} className={field} />
        </Field>
        <Field label="New Time Slot">
          <select value={form.slot} onChange={set("slot")} className={field}>
            <option value="">Choose a time</option>
            {TIME_SLOTS.map((t) => <option key={t}>{t}</option>)}
          </select>
        </Field>
        <Field label="Reason for rescheduling">
          <input value={form.reason} onChange={set("reason")} maxLength={120} placeholder="e.g. Work meeting" className={field} />
        </Field>
      </div>

      {error && <p className="animate-fade-up text-sm text-red-300">{error}</p>}
      {holiday && !error && (
        <p className="animate-fade-up text-sm text-yellow-200">{fmtDate(form.newDate)} is a public holiday ({holiday}). The gym may be closed.</p>
      )}
      {sent && (
        <p className="animate-pop-in rounded-xl bg-emerald-500/15 px-3 py-2 text-sm text-emerald-300">
          Request sent! Your trainer will review it and you'll see the update on your calendar.
        </p>
      )}

      <div className="flex justify-end">
        <button
          type="submit"
          disabled={!valid}
          className="rounded-full bg-blue-500 px-6 py-2 font-display text-lg transition hover:bg-blue-600 active:scale-95 disabled:cursor-not-allowed disabled:opacity-40"
        >
          Submit Request
        </button>
      </div>
    </form>
  );
}
</file>

<file path="src/components/SampleQr.jsx">
// Placeholder QR code (not scannable). Pattern is seeded, so each plan gets its own.
export default function SampleQr({ seed = "fittrack", className = "" }) {
  const N = 25;
  let h = 0;
  for (const c of seed) h = (h * 31 + c.charCodeAt(0)) >>> 0;
  const rnd = () => ((h = (h * 1664525 + 1013904223) >>> 0) / 2 ** 32);
  const inFinder = (x, y) => (x < 8 && y < 8) || (x >= N - 8 && y < 8) || (x < 8 && y >= N - 8);
  const cells = [];
  for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) if (!inFinder(x, y) && rnd() > 0.5) cells.push(<rect key={`${x}-${y}`} x={x} y={y} width="1" height="1" />);
  const finder = (x, y) => (
    <g key={`${x}${y}`}>
      <rect x={x} y={y} width="7" height="7" />
      <rect x={x + 1} y={y + 1} width="5" height="5" fill="#fff" />
      <rect x={x + 2} y={y + 2} width="3" height="3" />
    </g>
  );
  return (
    <svg viewBox={`-1 -1 ${N + 2} ${N + 2}`} className={className} role="img" aria-label="Sample payment QR code">
      <rect x="-1" y="-1" width={N + 2} height={N + 2} fill="#fff" />
      {cells}
      {finder(0, 0)}{finder(N - 7, 0)}{finder(0, N - 7)}
    </svg>
  );
}
</file>

