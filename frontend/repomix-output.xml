      </div>

      {toast && <div className="animate-pop-in fixed bottom-6 left-1/2 -translate-x-1/2 rounded-full bg-[#0f1b33] px-5 py-2 text-sm shadow-lg ring-1 ring-blue-400">{toast}</div>}
    </MemberLayout>
  );
}
